# ============================================================================
# LATechS Sales OS - environment variables
# Copy to .env for local development. On Vercel, add these in
# Project -> Settings -> Environment Variables. NEVER commit real values.
# ============================================================================

# --- Supabase PostgreSQL ------------------------------------------------------
# Preferred: a single connection string. For Vercel use the Supabase
# "Transaction" pooler URL (port 6543). Locally the direct URL (5432) is fine.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Individual settings (used only when DATABASE_URL is not set)
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=
DATABASE_PASSWORD=
# auto (default): TLS on for non-localhost hosts. Force with require|disable
DATABASE_SSL=
DATABASE_POOL_MAX=

# --- Claude API ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Model used for lead research, meeting prep and analysis (default claude-opus-5)
CLAUDE_MODEL=claude-opus-5
# Let Claude research businesses with live web search (recommended; default true)
CLAUDE_WEB_SEARCH=true
CLAUDE_WEB_SEARCH_MAX_USES=8
# Reasoning effort for research requests: low | medium | high (default medium)
CLAUDE_EFFORT=medium
# Server-side refusal fallbacks (default true; automatically degrades if unsupported)
CLAUDE_ENABLE_FALLBACKS=true
CLAUDE_TIMEOUT_MS=55000

# --- Optional business-data / search provider ---------------------------------
# none (default) | serper   (Serper.dev Google Places lookups verify phone/address/website)
LEAD_SEARCH_PROVIDER=none
SERPER_API_KEY=

# --- Security -------------------------------------------------------------------
# 32+ random characters. Encrypts per-user Claude API keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Shared secret for the scheduled rotation endpoint (/api/rotation/cron).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Cookie/session behaviour
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_DAYS=7
SECURE_COOKIES=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# --- Generation tuning ------------------------------------------------------------
# Contacts requested per Claude call (1-15). Lower = faster batches (also editable in Settings)
LEAD_GENERATION_BATCH_SIZE=5
LEAD_GENERATION_MAX_EMPTY_ATTEMPTS=4
# Time budget the cron endpoint spends continuing generation after rotation (ms)
LEAD_GENERATION_TIME_BUDGET_MS=45000

# --- App ------------------------------------------------------------------------------
APP_TIMEZONE=Asia/Karachi
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Tests ----------------------------------------------------------------------------
# A separate, disposable PostgreSQL database used by `npm test`
TEST_DATABASE_URL=postgresql://latechs:latechs@localhost:5432/latechs_test
