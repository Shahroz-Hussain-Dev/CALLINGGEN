# ============================================================================
# LATechS Sales OS - environment variables
# Copy to .env for local development. On Vercel, add these in
# Project -> Settings -> Environment Variables. NEVER commit real values.
# ============================================================================

# --- Supabase PostgreSQL ------------------------------------------------------
# Preferred: a single connection string. For Vercel use the Supabase
# "Transaction" pooler URL (port 6543). Locally the direct URL (5432) is fine.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Individual settings (used only when DATABASE_URL is not set)
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=
DATABASE_PASSWORD=
# auto (default): TLS on for non-localhost hosts. Force with require|disable
DATABASE_SSL=
DATABASE_POOL_MAX=

# --- AI provider ----------------------------------------------------------------
# gemini (default when GEMINI_API_KEY is set) | anthropic
AI_PROVIDER=gemini

# --- Google Gemini (Gemini Developer API, https://aistudio.google.com) -------
GEMINI_API_KEY=
# Primary model (best quality) and the fallback chain used automatically when a model is
# unavailable on the key's tier (quota exhausted, retired, or high demand)
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash,gemini-3.1-flash-lite
# Research mode: auto (default) uses Google Search grounding when the key has quota and otherwise the
# free built-in web research (DuckDuckGo searches + page reading + server-side fact verification);
# evidence = always use the free built-in research; native = always use Google grounding
GEMINI_RESEARCH_MODE=auto
GEMINI_EVIDENCE_THINKING=medium
GEMINI_EVIDENCE_TIMEOUT_MS=120000
# Google Search grounding + URL reading for research (needs a billed key; free tier has no grounding quota)
GEMINI_WEB_SEARCH=true
GEMINI_URL_CONTEXT=true
# Thinking depth: high | medium | low | off
GEMINI_THINKING=high
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_MS=170000
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=16384

# --- Anthropic Claude (used when AI_PROVIDER=anthropic) --------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Model used for lead research, meeting prep and analysis (default claude-opus-5)
CLAUDE_MODEL=claude-opus-5
# Let Claude research businesses with live web search (recommended; default true)
CLAUDE_WEB_SEARCH=true
CLAUDE_WEB_SEARCH_MAX_USES=8
# Reasoning effort for research requests: low | medium | high (default medium)
CLAUDE_EFFORT=medium
# Server-side refusal fallbacks (default true; automatically degrades if unsupported)
CLAUDE_ENABLE_FALLBACKS=true
CLAUDE_TIMEOUT_MS=55000

# --- Built-in web research (evidence mode) ---------------------------------------------
# Works with no key: direct DuckDuckGo where the network allows it, otherwise the key-less Jina Reader
# proxy (jina_reader: DuckDuckGo Lite / Bing result pages rendered by r.jina.ai, ~20 requests/minute),
# then Bing RSS. Optional free API keys (tried first) raise quality and throughput; the owner can also
# paste them in Settings -> System configuration (stored encrypted).
WEB_SEARCH_ENGINE=duckduckgo          # preferred key-less engine: duckduckgo | jina_reader (use on Vercel) | bing
JINA_MIN_GAP_MS=3200                  # spacing between key-less Jina Reader calls (20/minute limit)
JINA_RATE_LIMIT_COOLDOWN_MS=90000     # pause after a Jina 429 before the proxy engine is retried
EVIDENCE_JINA_PAGE_FALLBACKS=3        # pages re-read through Jina Reader when a site blocks direct fetches
SERPER_API_KEY=                       # https://serper.dev  - Google results, 2,500 free searches (recommended)
JINA_API_KEY=                         # https://jina.ai     - free key with a large token allowance
TAVILY_API_KEY=                       # https://tavily.com  - 1,000 free searches / month
BRAVE_SEARCH_API_KEY=                 # https://brave.com/search/api/ (card required)
GOOGLE_CSE_API_KEY=                   # Google Programmable Search JSON API (100 queries / day free)
GOOGLE_CSE_ID=
EVIDENCE_TIME_BUDGET_MS=45000
EVIDENCE_MAX_PAGES=8

# --- Optional business-data / search provider ---------------------------------
# none (default) | serper   (Serper.dev Google Places lookups verify phone/address/website)
LEAD_SEARCH_PROVIDER=none
SERPER_API_KEY=

# --- Security -------------------------------------------------------------------
# 32+ random characters. Encrypts per-user Claude API keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Shared secret for the scheduled rotation endpoint (/api/rotation/cron).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Cookie/session behaviour
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_DAYS=7
SECURE_COOKIES=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# --- Generation tuning ------------------------------------------------------------
# Contacts requested per Claude call (1-15). Lower = faster batches (also editable in Settings)
LEAD_GENERATION_BATCH_SIZE=5
LEAD_GENERATION_MAX_EMPTY_ATTEMPTS=4
# Time budget the cron endpoint spends continuing generation after rotation (ms)
LEAD_GENERATION_TIME_BUDGET_MS=45000

# --- App ------------------------------------------------------------------------------
APP_TIMEZONE=Asia/Karachi
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Tests ----------------------------------------------------------------------------
# A separate, disposable PostgreSQL database used by `npm test`
TEST_DATABASE_URL=postgresql://latechs:latechs@localhost:5432/latechs_test
