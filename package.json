{
  "name": "latechs-sales-os",
  "version": "1.0.0",
  "description": "LATechS internal lead generation, sales strategy and meeting management system",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo.js",
    "rotation:run": "node scripts/run-rotation.js",
    "db:status": "node scripts/db-status.js",
    "db:probe": "node scripts/db-probe.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "node --check server/app.js && node --check api/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
